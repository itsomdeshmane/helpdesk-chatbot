# Cache TTL Settings (in seconds)
CACHE_EMBEDDING_TTL=86400
CACHE_SEARCH_TTL=3600
CACHE_RESPONSE_TTL=1800

# ============================================
# Server Configuration
# ============================================
DEBUG=true
LOG_LEVEL=INFO
ENVIRONMENT=development
LOG_FORMAT=json

# ============================================
# CORS Configuration
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# ============================================
# Feature Flags (Optional)
# ============================================
# Enable/disable specific features
ENABLE_SMART_CHAT=true
ENABLE_DATABASE_QUERIES=true
ENABLE_DOCUMENT_SEARCH=true
ENABLE_STREAMING=true
ENABLE_SOURCE_ATTRIBUTION=true
ENABLE_QUALITY_SCORING=true
ENABLE_SUGGESTIONS=true
ENABLE_FEEDBACK=true

# ============================================
# Search Configuration
# ============================================
USE_HYBRID_SEARCH=true
HYBRID_SEARCH_ALPHA=0.6
USE_QUERY_REWRITING=true
SEARCH_TOP_K=5

# ============================================
# Chunking Configuration
# ============================================
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=50

# ============================================
# Performance Settings (Optional)
# ============================================
# Query timeouts in seconds
DATABASE_QUERY_TIMEOUT=30
DOCUMENT_SEARCH_TIMEOUT=10
LLM_GENERATION_TIMEOUT=60

# Maximum results to return
MAX_SEARCH_RESULTS=10
MAX_DATABASE_ROWS=1000

# ============================================
# Logging Configuration (Optional)
# ============================================
LOG_FILE=logs/backend.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5



